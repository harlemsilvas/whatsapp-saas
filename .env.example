# Copie para .env e ajuste conforme seu ambiente.
# Nunca versione credenciais reais.

# HTTP
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS
# Em desenvolvimento, se CORS_ALLOWED_ORIGINS ficar vazio, qualquer origem de browser e aceita.
# Em produção, defina explicitamente as origens permitidas separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Recomendado manter true para requests sem Origin, como webhooks e ferramentas CLI.
CORS_ALLOW_NO_ORIGIN=true
# Ative apenas se for usar cookies/autenticacao baseada em browser.
CORS_ALLOW_CREDENTIALS=false

# Admin
ADMIN_API_KEY=troque-este-valor
# Em produção, a aplicacao passa a exigir ADMIN_API_KEY por padrao.
REQUIRE_ADMIN_API_KEY=true

# Banco
DB_HOST=localhost
DB_USER=app_user
DB_PASS=troque-esta-senha
DB_NAME=whatsapp_saas
DB_PORT=5432
POSTGRES_DB=whatsapp_saas
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=troque-a-senha-do-postgres
APP_DB_USER=app_user
APP_DB_PASS=troque-a-senha-do-app
# Em producao, recomendado manter true.
REQUIRE_DB_ENV=false

# WhatsApp Cloud API
WHATSAPP_URL=https://graph.facebook.com/v23.0
WHATSAPP_TOKEN=SEU_TOKEN_WHATSAPP
WHATSAPP_PHONE_ID=SEU_PHONE_NUMBER_ID
VERIFY_TOKEN=SEU_VERIFY_TOKEN
WHATSAPP_APP_SECRET=SEU_APP_SECRET
WHATSAPP_TEMPLATE_LANG=pt_BR
REQUIRE_WHATSAPP_ENV=false
REQUIRE_VERIFY_TOKEN=false
REQUIRE_WHATSAPP_WEBHOOK_SIGNATURE=false

# Multiempresa / fallback de desenvolvimento
DEFAULT_EMPRESA_ID=1
ALLOW_PHONE_ID_FALLBACK=true
MEU_TELEFONE=5511999999999

# URL publica para onboarding/documentacao da Meta
APP_PUBLIC_BASE_URL=https://seu-dominio.com

# OpenAI (habilita respostas por IA)
# IMPORTANTE: nunca coloque sua chave em comandos (curl/node -e) para não ficar no histórico.
OPENAI_API_KEY=SEU_TOKEN_OPENAI
# Ex.: gpt-5-nano (conforme sua conta) ou gpt-4o-mini
OPENAI_MODEL=gpt-5-nano
# responses (recomendado) ou chat
OPENAI_API_STYLE=responses
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_OUTPUT_TOKENS=220
OPENAI_TEMPERATURE=0.4
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_CONTEXT_MESSAGES=8
OPENAI_REASONING_EFFORT=low

# Alertas de handoff humano
HUMAN_ALERT_WHATSAPP_TO=5511999999999
HUMAN_ALERT_TEMPLATE_NAME=seu_template_aprovado
HUMAN_ALERT_TEMPLATE_LANG=pt_BR
HUMAN_TAKEOVER_PAUSE_MINUTES=60
WHATSAPP_REENGAGE_TEMPLATE_NAME=seu_template_reengajamento
WHATSAPP_REENGAGE_TEMPLATE_LANG=pt_BR

# Webhook worker
WEBHOOK_WORKER_POLL_INTERVAL_MS=5000
WEBHOOK_WORKER_BATCH_LIMIT=20
WEBHOOK_WORKER_LEASE_SECONDS=60
WEBHOOK_WORKER_STATUSES=failed

# Perfil da empresa (base de conhecimento)
# Recomendo usar PATH (arquivo) para facilitar manutenção.
AI_COMPANY_PROFILE_PATH=src/ai/perfil-empresa.md
# Alternativa: texto inline (menos recomendado)
# AI_COMPANY_PROFILE_TEXT=
AI_COMPANY_PROFILE_MAX_CHARS=4000
AI_COMPANY_PROFILE_CACHE_MS=30000

# Texto quando a IA estiver desativada/falhar
AI_FALLBACK_TEXT=No momento não consegui responder automaticamente. Você pode detalhar um pouco mais ou aguardar um atendente?

# Paginas publicas / identidade
SERVICE_NAME=WhatsApp SaaS
LEGAL_ENTITY_NAME=Sua Empresa LTDA
LEGAL_CONTACT_EMAIL=contato@seu-dominio.com
